# flux.ai - Backend API configuration
# This frontend is designed to connect to a FastAPI/LangGraph backend running locally.
# Copy this file to .env when a compatible FastAPI service is available.
VITE_API_URL=http://localhost:8000
#
# The backend must implement:
#   GET  /health          -> readiness check
#   POST /research        -> submit a query and start a run
#   GET  /research/{id}   -> get run status and report
#   GET  /research/{id}/events -> optional SSE stream
#
# The current Python project is a terminal application and does not yet
# implement these HTTP routes. Leave the variable unset to stay disconnected.
